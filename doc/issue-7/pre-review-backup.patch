+/** 执行外部命令并在失败时抛错（替代裸 spawnSync 的静默失败） */
+function runSyncSafe(cmd, args, options = {}) {
+  const res = spawnSync(cmd, args, { encoding: 'utf8', maxBuffer: 32 * 1024 * 1024, ...options });
