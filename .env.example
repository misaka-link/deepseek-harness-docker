# ========================================================
# deepseek-harness-docker 环境变量配置文件模板
# ========================================================

# 访问认证码 (Access Code)
# 浏览器访问 DSH Web、/admin 管理后台和 /vnc 桌面时需要输入此口令
# 留空（推荐）：首次访问会引导到「初始化访问口令」页面，设置后才可使用；
#               口令将以 0600 权限持久化到数据卷，容器重启后依然有效。
# 显式填写：跳过初始化向导，直接使用该口令（请勿使用 admin 等弱口令）。
AUTH_TOKEN=

# Session 会话签名密钥 (可选)
# 默认首次启动会自动生成 256 位高强度随机密钥并持久化至数据卷 (/root/.dsh/.session_secret)
# 如需跨机器集群共享会话或手动指定，可在此取消注释配置
# SESSION_SECRET=your_custom_long_random_secret_here

# 统一对外代理端口 (默认 3080)
# 说明：显式设置时【优先于】数据卷中的持久化配置（M13），并会同时决定 compose 的宿主端口映射；
#       留空/不设置则用 3080。
PROXY_PORT=3080

# 是否信任反向代理转发的 X-Forwarded-For（默认 0）
# 仅当网关确实部署在可信反向代理（Nginx/Traefik 等）之后时才设为 1，
# 否则任何人都能伪造 XFF 让登录限流失效（M1）。
# TRUST_PROXY=0

# 对外主机名白名单（逗号分隔，用于 WebSocket 同源校验）
# 例如：PUBLIC_HOST=dsh.example.com
# PUBLIC_HOST=

# --- 以下可选配置项，默认注释：---
# ADMIN_PATH=/admin
# VNC_PATH=/vnc
# DSH_WORKSPACE=/workspace
# DSH_DESKTOP_ENABLED=1
# DSH_IDLE_TIMEOUT_MINUTES=30
# DSH_DESKTOP_WIDTH=1920
# DSH_DESKTOP_HEIGHT=1080
# DSH_SCREENSHOT_QUALITY=high          # AI 截图默认画质 (high/medium/low，默认 high)
# DSH_SCREENSHOT_DIR=                  # AI 截图默认保存子目录 (相对工作区，留空=根目录)

# ─────────────────────────────────────────────────────────────
# 出站网络代理配置 (可选：用于模型 API、Web 搜索或插件下载走代理)
# DSH 官方 0.1.5-rc.1 起全面原生遵循出站代理设置
# ─────────────────────────────────────────────────────────────
# HTTP_PROXY=http://172.17.0.1:7890
# HTTPS_PROXY=http://172.17.0.1:7890
# ALL_PROXY=socks5://172.17.0.1:7890
# NO_PROXY=localhost,127.0.0.1,dsh
