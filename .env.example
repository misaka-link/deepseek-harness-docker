# ========================================================
# deepseek-harness-docker 环境变量配置文件模板
# ========================================================

# 访问认证码 (Access Code)
# 浏览器访问 DSH Web、/admin 管理后台和 /vnc 桌面时需要输入此口令
AUTH_TOKEN=admin

# 统一对外代理端口 (默认 3080)
PROXY_PORT=3080

# --- 以下可选配置项，默认注释：---
# ADMIN_PATH=/admin
# VNC_PATH=/vnc
# DSH_WORKSPACE=/workspace
# DSH_DESKTOP_ENABLED=1
# DSH_IDLE_TIMEOUT_MINUTES=30
# DSH_DESKTOP_WIDTH=1440
# DSH_DESKTOP_HEIGHT=900

# ─────────────────────────────────────────────────────────────
# 出站网络代理配置 (可选：用于模型 API、Web 搜索或插件下载走代理)
# DSH 官方 0.1.5-rc.1 起全面原生遵循出站代理设置
# ─────────────────────────────────────────────────────────────
# HTTP_PROXY=http://172.17.0.1:7890
# HTTPS_PROXY=http://172.17.0.1:7890
# ALL_PROXY=socks5://172.17.0.1:7890
# NO_PROXY=localhost,127.0.0.1,dsh
